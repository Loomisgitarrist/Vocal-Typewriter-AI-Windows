<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Microphone access -->
    <key>com.apple.security.device.microphone</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Accessibility for auto-typing -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Allow JIT for performance -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Allow unsigned memory for tract ML inference -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Disable library validation for dynamic loading -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Access to Downloads folder -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    <!-- User Selected Files (Required for Custom Model Path) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>