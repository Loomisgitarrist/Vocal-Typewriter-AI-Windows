<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Application Identifier -->
    <key>com.apple.application-identifier</key>
    <string>555HHF3KGU.com.vocaltypewriter.newapp</string>

    <!-- Enable App Sandbox (REQUIRED for App Store) -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Network Access (Required for OpenRouter/OpenAI/Updates) -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Microphone Access -->
    <key>com.apple.security.device.microphone</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- File Access (User Selected Files Only - standard for Sandboxed apps) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    
    <!-- Allow JIT (often needed for webviews/performance) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
